{
  "manifest_version": 3,
  "name": "Startpage New Tab",
  "version": "1.4.0",
  "description": "Opens Startpage in every new tab and turns address-bar searches into Startpage searches. Built for Opera GX.",
  "permissions": ["tabs", "webNavigation"],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.google.es/*",
    "*://*.google.com.mx/*",
    "*://*.google.com.ar/*",
    "*://*.google.com.co/*",
    "*://*.google.cl/*",
    "*://*.google.com.br/*",
    "*://*.google.de/*",
    "*://*.google.fr/*",
    "*://*.google.it/*",
    "*://*.google.nl/*",
    "*://*.google.pt/*",
    "*://*.google.co.uk/*",
    "*://*.google.ca/*",
    "*://*.google.com.au/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "Startpage",
      "keyword": "sp",
      "search_url": "https://www.startpage.com/do/dsearch?query={searchTerms}",
      "suggest_url": "https://www.startpage.com/osuggestions?q={searchTerms}",
      "favicon_url": "https://www.startpage.com/favicon.ico",
      "encoding": "UTF-8",
      "is_default": true
    }
  }
}
